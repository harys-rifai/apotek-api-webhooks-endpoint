# Django
SECRET_KEY=change-me-to-a-safe-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# URL base API ApotekApps (tanpa trailing slash)
APOTEK_API_BASE_URL=http://127.0.0.1:8000/api

# Kredensial admin ApotekApps untuk login awal
APOTEK_ADMIN_USERNAME=admin
APOTEK_ADMIN_PASSWORD=admin

# PostgreSQL backup replica (bisa beda port dengan ApotekApps/.env)
# Jika kosong, script akan otomatis mendeteksi port (5006/5008/5007/5009/5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=apotek_pos
DB_USER=postgres
DB_PASSWORD=Password09!
DB_HOST=localhost
DB_PORT=5006
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=your-email@gmail.com
OPENROUTER_API_KEY=your-api-key

# Enkripsi credential di SQLite. Gunakan salah satu:
# 1. DB_ENCRYPTION_KEY=<output manage.py generate_encryption_key>
# 2. DB_ENCRYPTION_KEY_FILE=.encryption_key
DB_ENCRYPTION_KEY=
DB_ENCRYPTION_KEY_FILE=.encryption_key